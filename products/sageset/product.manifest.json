    "maestro": {
      "defaultSuite": "phase1",
      "reportDirectory": "reports/mobile/sageset/maestro",
      "suites": {
        "phase1": [
          "00-launch-smoke",
          "01-login-smoke",
          "10-gamification-progression",
          "20-groups-challenges"
        ],
        "phase2": [
          "30-invitation-pending",
          "31-member-active",
          "32-member-paused",
          "33-member-resumed",
          "34-progress-recorded",
          "35-member-removed"
        ],
