{
  "key": "merxus",
  "name": "Merxus",
  "type": "react-vite",
  "status": "active",
  "baseUrl": {
    "local": "http://127.0.0.1:5174",
    "staging": "https://merxus-staging.netlify.app",
    "production": "https://merxus.com"
  },
  "devServer": {
    "enabled": true,
    "workingDirectory": "C:/Users/sjroy/Source/Merxus/web",
    "command": "npm run dev -- --host 127.0.0.1 --port 5174",
    "port": 5174,
    "healthUrl": "http://127.0.0.1:5174",
    "healthTimeoutMs": 60000
  },
  "auth": {
    "strategy": "email-password",
    "loginPath": "/login",
    "demoUserEnvKey": "MERXUS_DEMO_EMAIL",
    "demoPasswordEnvKey": "MERXUS_DEMO_PASSWORD",
    "selectors": {
      "email": "#email",
      "password": "#password",
      "submit": "button[type=\"submit\"]:has-text(\"Sign in\")"
    }
  },
  "browserWorkflows": {
    "workflow": {
      "path": "products/merxus/workflows/workflow.js",
      "publicRoute": "/",
      "publicSelectors": ["text=Merxus", "text=AI communication"],
      "dashboardRoute": "/merxus",
      "dashboardSelectors": ["text=Merxus AI", "text=Dashboard", "text=All Tenants"],
      "safeScreenshot": {
        "fullPage": false
      },
      "areas": [
        {
          "name": "tenant",
          "routes": ["/merxus/tenants"],
          "selectors": ["text=All Tenants", "text=Tenants", "text=Tenant"]
        },
        {
          "name": "calls",
          "routes": ["/voice/calls", "/restaurant/calls", "/estate/calls", "/merxus/voices"],
          "selectors": ["text=Calls & Messages", "text=Calls", "text=Voice Services"]
        },
        {
          "name": "transcripts",
          "routes": ["/voice/calls", "/restaurant/calls", "/estate/calls", "/merxus/voices"],
          "selectors": ["text=Transcript", "text=transcript", "text=Speech", "text=Voice Services"]
        },
        {
          "name": "leads",
          "routes": ["/estate/leads", "/merxus/real-estate", "/merxus/analytics"],
          "selectors": ["text=Leads", "text=Real Estate", "text=Analytics"]
        },
        {
          "name": "reviews",
          "routes": ["/voice/reviews", "/restaurant/reviews", "/estate/reviews"],
          "selectors": ["[data-testid=\"review-workspace\"]", "text=Reviews", "text=Review Feed"]
        }
      ]
    }
  },
  "firebase": {
    "enabled": true,
    "projectId": "merxus-prod",
    "credentialFile": "merxus.json"
  },
  "api": {
    "enabled": true,
    "healthChecks": [
      {
        "name": "cloud-run-health",
        "urlEnvKey": "MERXUS_API_HEALTH_URL",
        "expectedStatus": 200,
        "required": false
      }
    ]
  },
  "performance": {
    "enabled": true,
    "maxNetworkFailures": 0
  },
  "accessibility": {
    "enabled": true,
    "tags": ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"]
  },
  "visualRegression": {
    "enabled": true,
    "threshold": 0.01,
    "maxMismatchRatio": 0.0025
  },
  "ai": {
    "enabled": true,
    "testCases": [
      {
        "name": "restaurant-hours",
        "persona": "restaurant-owner",
        "scenario": "Customer asks for restaurant hours.",
        "expectedIntent": "answer-hours-or-escalate-to-configured-business-data"
      },
      {
        "name": "speak-to-human",
        "persona": "frustrated-user",
        "scenario": "Customer asks to speak to a human.",
        "expectedIntent": "handoff-request"
      }
    ]
  },
  "mobile": {
    "enabled": true,
    "orchestrationAuthority": "worksideqa",
    "appId": "com.merxus.mobile.qa",
    "productionAppId": "com.merxus.mobile",
    "applicationSourceEnvKey": "MERXUS_MOBILE_REPO",
    "environment": {
      "name": "maestro",
      "backend": "firebase-emulators",
      "backendUrl": "http://127.0.0.1:8787",
      "firebaseProjectId": "merxus-maestro-local",
      "externalNotificationsAllowed": false,
      "externalProvidersAllowed": false,
      "emulators": { "auth": 9099, "firestore": 8080, "storage": 9199 }
    },
    "devices": {
      "iosSimulator": {
        "platform": "ios",
        "kind": "simulator",
        "idEnvKey": "MERXUS_IOS_SIMULATOR_ID",
        "appId": "com.merxus.mobile.qa",
        "launchUri": "exp+merxus-mobile://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081",
        "launchReadySelector": "qa-environment-root",
        "launchReadyTimeoutMs": 30000,
        "launchDismissIfVisible": ["Continue", "Close"],
        "postActionDismissIfVisible": [
          {
            "afterTapId": "auth.login.submit",
            "visible": "Save Password?",
            "tap": "Not Now"
          }
        ],
        "deterministicTextEntry": [
          {
            "id": "auth.login.email",
            "secure": false,
            "assertExact": true
          },
          {
            "id": "auth.login.password",
            "secure": true,
            "assertExact": false
          }
        ]
      },
      "androidEmulator": {
        "platform": "android",
        "kind": "emulator",
        "idEnvKey": "MERXUS_ANDROID_EMULATOR_ID",
        "appId": "com.merxus.mobile.qa",
        "launchUri": "exp+merxus-mobile://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081%3FdisableOnboarding%3D1",
        "launchReadySelector": "qa-environment-root",
        "launchReadyTimeoutMs": 30000
      }
    },
    "phase0": {
      "backendSourceEnvKey": "MERXUS_BACKEND_REPO",
      "preflightCommand": ["npm", "run", "qa:maestro:preflight"],
      "authoritativeFirebaseRoot": "../web"
    },
    "fixtures": {
      "owner": "merxus",
      "sourceEnvKey": "MERXUS_BACKEND_REPO",
      "packageJsonRelative": "package.json",
      "command": "npm",
      "args": ["run", "qa:maestro:reset", "--"],
      "projectId": "merxus-maestro-local",
      "passGeneration": true,
      "scenarios": ["login-owner-a"],
      "environment": {
        "MERXUS_QA_ENVIRONMENT": "maestro",
        "MERXUS_MAESTRO_FIREBASE_PROJECT_ID": "merxus-maestro-local",
        "MERXUS_QA_BACKEND_URL": "http://127.0.0.1:8787",
        "MERXUS_ALLOW_EXTERNAL_PROVIDERS": "false",
        "MERXUS_MAESTRO_PROVIDER_INTENT_LOG": ".tmp/maestro-provider-intents.jsonl"
      },
      "credentialEnvKeys": {
        "userAEmail": "MERXUS_MAESTRO_OWNER_A_EMAIL",
        "userAPassword": "MERXUS_MAESTRO_OWNER_A_PASSWORD",
        "userBEmail": "MERXUS_MAESTRO_OWNER_B_EMAIL",
        "userBPassword": "MERXUS_MAESTRO_OWNER_B_PASSWORD"
      },
      "verification": {
        "command": "npm",
        "args": ["run", "qa:maestro:verify", "--"],
        "argumentName": "--case",
        "includeScenario": true,
        "mutations": ["login-owner-a", "tenant-isolation-a-b", "logout-no-mutation"]
      }
    },
    "flows": [
      {
        "name": "00-launch-environment",
        "path": "products/merxus/workflows/00-launch-environment.yaml",
        "fixtureScenario": "login-owner-a",
        "backendVerification": "login-owner-a",
        "account": "user-a",
        "requiredEnv": ["MERXUS_MAESTRO_OWNER_A_EMAIL", "MERXUS_MAESTRO_OWNER_A_PASSWORD"],
        "timeoutMs": 60000
      },
      {
        "name": "01-login-owner-a",
        "path": "products/merxus/workflows/01-login-owner-a.yaml",
        "fixtureScenario": "login-owner-a",
        "backendVerification": "login-owner-a",
        "account": "user-a",
        "requiredEnv": ["MERXUS_MAESTRO_OWNER_A_EMAIL", "MERXUS_MAESTRO_OWNER_A_PASSWORD"],
        "timeoutMs": 90000
      },
      {
        "name": "02-tenant-isolation",
        "path": "products/merxus/workflows/02-tenant-isolation.yaml",
        "fixtureScenario": "login-owner-a",
        "backendVerification": "tenant-isolation-a-b",
        "account": "user-a",
        "requiredEnv": ["MERXUS_MAESTRO_OWNER_A_EMAIL", "MERXUS_MAESTRO_OWNER_A_PASSWORD"],
        "timeoutMs": 90000
      },
      {
        "name": "03-logout",
        "path": "products/merxus/workflows/03-logout.yaml",
        "fixtureScenario": "login-owner-a",
        "backendVerification": "logout-no-mutation",
        "account": "user-a",
        "requiredEnv": ["MERXUS_MAESTRO_OWNER_A_EMAIL", "MERXUS_MAESTRO_OWNER_A_PASSWORD"],
        "timeoutMs": 90000
      }
    ],
    "maestro": {
      "defaultSuite": "phase1",
      "timeoutMs": 90000,
      "processStartupGraceMs": 15000,
      "reportDirectory": "reports/mobile/merxus/maestro",
      "suites": {
        "phase1": ["00-launch-environment", "01-login-owner-a", "02-tenant-isolation", "03-logout"]
      }
    }
  },
  "reviewCanary": {
    "enabled": true,
    "runner": "products/merxus/reviews/review-canary-runner.js",
    "groups": ["smoke", "google", "errors", "full"],
    "externalProviderWrites": false
  },
  "suites": {
    "smoke": ["load", "login", "dashboard", "basic-navigation"],
    "workflow": ["workflow", "performance"],
    "regression": ["login", "dashboard", "call-handling", "transcripts"],
    "release": ["smoke", "api", "firebase", "accessibility", "performance", "ai"]
  },
  "personas": ["restaurant-owner", "frustrated-user"],
  "tags": ["web", "firebase", "cloud-run", "ai", "twilio"]
}
