# Copy this file to:
# C:\Users\sjroy\Source\WorksideQA\.maestro.local.ps1
# DO NOT COMMIT THE REAL .maestro.local.ps1

# Windows toolchain pins (required for deterministic launcher behavior). These
# values are machine-local paths, not credentials; use environment expansion so
# the file remains portable between supported installations.
$env:WORKSIDEQA_FIREBASE_BIN = "%NVM_SYMLINK%\firebase.cmd"
$env:WORKSIDEQA_JAVA_BIN = "<SET LOCALLY: JDK 21 bin\java.exe>"

$env:MERXUS_BACKEND_REPO = "C:\Users\sjroy\Source\Merxus\merxus-ai-backend"
# macOS checkouts may be separate from the WorksideQA directory. Set these in
# the ignored local file when needed (do not commit user-specific paths):
# $env:MERXUS_ROOT_REPO = "/Users/<user>/Desktop/Development/merxusmobile"
# $env:MERXUS_MOBILE_REPO = "/Users/<user>/Desktop/Development/merxusmobile"
# $env:MERXUS_WEB_REPO = "/Users/<user>/Desktop/Development/merxus-web"
$env:MERXUS_MAESTRO_OWNER_A_EMAIL = "owner-a@merxus-maestro.test"
$env:MERXUS_MAESTRO_OWNER_A_PASSWORD = "<SET LOCALLY: canonical QA password>"
$env:MERXUS_MAESTRO_OWNER_B_EMAIL = "owner-b@merxus-maestro.test"
$env:MERXUS_MAESTRO_OWNER_B_PASSWORD = "<SET LOCALLY: canonical QA password>"
$env:MERXUS_MAESTRO_MANAGER_A_EMAIL = "manager-a@merxus-maestro.test"
$env:MERXUS_MAESTRO_MANAGER_A_PASSWORD = "<SET LOCALLY: canonical QA password>"
$env:MERXUS_MAESTRO_STAFF_A_EMAIL = "staff-a@merxus-maestro.test"
$env:MERXUS_MAESTRO_STAFF_A_PASSWORD = "<SET LOCALLY: canonical QA password>"
$env:MERXUS_ANDROID_EMULATOR_ID = "emulator-5554"
# Optional when more than one AVD is installed. When omitted, WorksideQA
# accepts the single installed AVD and otherwise asks for an explicit name.
$env:MERXUS_ANDROID_AVD_NAME = "<SET LOCALLY when multiple AVDs are installed>"
$env:MERXUS_IOS_SIMULATOR_ID = "<SET LOCALLY: simulator UDID>"
$env:MERXUS_MAESTRO_FIREBASE_PROJECT_ID = "merxus-maestro-local"
$env:MERXUS_MAESTRO_ANDROID_APP_ID = "com.merxus.mobile.qa"

# SageSet Maestro fixture contract (required for SageSet suites)
$env:SAGESET_MOBILE_REPO = "C:\Users\sjroy\Source\SageSet\mobile"
$env:SAGESET_MAESTRO_USER_A_EMAIL = "<SET LOCALLY: canonical QA email>"
$env:SAGESET_MAESTRO_USER_A_PASSWORD = "<SET LOCALLY: canonical QA password>"
$env:SAGESET_MAESTRO_USER_B_EMAIL = "<SET LOCALLY: canonical QA email>"
$env:SAGESET_MAESTRO_USER_B_PASSWORD = "<SET LOCALLY: canonical QA password>"
$env:SAGESET_MAESTRO_QA_EMAIL_ALLOWLIST = "<USER_A_EMAIL>,<USER_B_EMAIL>"
$env:SAGESET_ANDROID_EMULATOR_ID = "emulator-5554"
# This Windows installation shares the single installed QA AVD with Merxus.
# Set the actual configured AVD name when more than one AVD is installed.
$env:SAGESET_ANDROID_AVD_NAME = "<SET LOCALLY when multiple AVDs are installed>"
$env:SAGESET_MAESTRO_ANDROID_APP_ID = "com.workside.sageset"
