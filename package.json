{
  "name": "worksideqa",
  "version": "0.1.0-alpha",
  "description": "Shared QA automation platform for Workside Software products.",
  "main": "packages/qa-core/src/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "qa": "node packages/qa-core/src/cli.js",
    "qa:radiusiq": "node packages/qa-core/src/cli.js --product radiusiq --suite smoke --start-server",
    "qa:merxus": "node packages/qa-core/src/cli.js --product merxus --suite smoke --start-server",
    "qa:sageset": "node packages/qa-core/src/cli.js --product sageset --suite smoke --start-server",
    "qa:sageset:maestro": "node packages/qa-mobile/src/maestro-cli.js --product sageset",
    "qa:sageset:maestro:phase1": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase1",
    "qa:sageset:maestro:validate": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase1 --validate",
    "qa:sageset:maestro:phase2": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase2",
    "qa:sageset:maestro:phase2:validate": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase2 --validate",
    "qa:sageset:maestro:phase3": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase3",
    "qa:sageset:maestro:phase3:validate": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase3 --validate",
    "qa:sageset:maestro:phase4": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase4",
    "qa:sageset:maestro:phase4:validate": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase4 --validate",
    "qa:sageset:maestro:phase5": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase5",
    "qa:sageset:maestro:phase5:validate": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase5 --validate",
    "qa:sageset:maestro:phase6": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase6",
    "qa:sageset:maestro:phase6:validate": "node packages/qa-mobile/src/maestro-cli.js --product sageset --suite phase6 --validate",
    "qa:sageset:release-certify": "node packages/qa-mobile/src/release-certification-cli.js --product sageset",
    "qa:sageset:release-certify:validate": "node packages/qa-mobile/src/release-certification-cli.js --product sageset --validate-only",
    "test:release-certification": "node packages/qa-mobile/test/release-certification.test.js && node packages/qa-mobile/test/release-certification-report.test.js",
    "test:mobile": "node packages/qa-mobile/test/maestro-runner.test.js && npm run test:release-certification",
    "qa:all": "node packages/qa-core/src/cli.js --all --suite smoke",
    "qa:radiusiq:workflow": "node packages/qa-core/src/cli.js --product radiusiq --suite workflow --start-server",
    "qa:merxus:workflow": "node packages/qa-core/src/cli.js --product merxus --suite workflow --start-server",
    "qa:merxus:reviews:smoke": "node products/merxus/reviews/review-canary-runner.js --suite smoke",
    "qa:merxus:reviews:google": "node products/merxus/reviews/review-canary-runner.js --suite google",
    "qa:merxus:reviews:errors": "node products/merxus/reviews/review-canary-runner.js --suite errors",
    "qa:merxus:reviews:full": "node products/merxus/reviews/review-canary-runner.js --suite full",
    "qa:sageset:workflow": "node packages/qa-core/src/cli.js --product sageset --suite workflow --start-server",
    "qa:route-logistics:workflow": "node packages/qa-core/src/cli.js --product route-logistics --suite workflow --start-server",
    "qa:support-console:workflow": "node packages/qa-core/src/cli.js --product support-console --suite workflow --start-server",
    "qa:anyryde:workflow": "node packages/qa-core/src/cli.js --product anyryde --suite workflow --start-server",
    "qa:workflows": "npm run qa:radiusiq:workflow && npm run qa:merxus:workflow && npm run qa:sageset:workflow && npm run qa:route-logistics:workflow && npm run qa:support-console:workflow && npm run qa:anyryde:workflow",
    "qa:radiusiq:dry": "node packages/qa-core/src/cli.js --product radiusiq --suite smoke --dry-run",
    "qa:all:dry": "node packages/qa-core/src/cli.js --all --suite smoke --dry-run",
    "qa:release": "node packages/qa-core/src/release-workflow.js",
    "qa:release:no-open": "node packages/qa-core/src/release-workflow.js --no-open",
    "qa:release:dry": "node packages/qa-core/src/release-workflow.js --dry-run --no-open",
    "qa:release:radiusiq": "node packages/qa-core/src/release-workflow.js --product radiusiq",
    "qa:release:merxus": "node packages/qa-core/src/release-workflow.js --product merxus",
    "qa:ci": "node packages/qa-core/src/ci-profile.js",
    "qa:dashboard:data": "node packages/qa-reporting/src/build-dashboard-data.js",
    "qa:ai-review": "node packages/qa-core/src/cli.js --ai-review",
    "qa:executive-email": "node packages/qa-reporting/src/executive-email.js",
    "qa:executive-email:send": "node packages/qa-reporting/src/executive-email.js --send",
    "qa:bug-report": "node packages/qa-openai/src/generate-bug-report.js",
    "qa:env": "node packages/qa-config/src/print-env-status.js",
    "qa:env:health": "node packages/qa-config/src/env-health.js",
    "qa:env:health:offline": "node packages/qa-config/src/env-health.js --skip-network",
    "qa:safety:gate": "node packages/qa-core/src/safety-gate.js",
    "qa:report": "node packages/qa-reporting/src/open-latest-report.js",
    "test": "node packages/qa-core/src/cli.js --product radiusiq --suite smoke --dry-run"
  },
  "keywords": [],
  "author": "Workside Software LLC",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "pngjs": "^7.0.0",
    "yaml": "^2.8.1"
  }
}
