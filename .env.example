# WorksideQA local environment examples.
# Copy to .env.local and fill only the values needed for local runs.

WORKSIDEQA_ENVIRONMENT=local
WORKSIDEQA_HEADLESS=true
WORKSIDEQA_OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_KEY=

# Optional read-only Firebase verification.
WORKSIDEQA_FIREBASE_CREDENTIALS_DIR=C:/Users/sjroy/Source/WorksideSecrets/firebase
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ACCESS_TOKEN=

RADIUSIQ_DEMO_EMAIL=
RADIUSIQ_DEMO_PASSWORD=

MERXUS_DEMO_EMAIL=
MERXUS_DEMO_PASSWORD=

SAGESET_DEMO_EMAIL=
SAGESET_DEMO_PASSWORD=

# SageSet iOS Simulator / Maestro pilot. Keep passwords in .env.local or the
# runner shell only; WorksideQA passes these values to Maestro with -e.
SAGESET_MOBILE_REPO=
SAGESET_MAESTRO_USER_A_EMAIL=
SAGESET_MAESTRO_USER_A_PASSWORD=
SAGESET_MAESTRO_USER_B_EMAIL=
SAGESET_MAESTRO_USER_B_PASSWORD=
SAGESET_MAESTRO_QA_EMAIL_ALLOWLIST=

SUPPORT_CONSOLE_DEMO_EMAIL=
SUPPORT_CONSOLE_DEMO_PASSWORD=

ROUTE_LOGISTICS_DEMO_EMAIL=
ROUTE_LOGISTICS_DEMO_PASSWORD=

ANYRYDE_DEMO_EMAIL=
ANYRYDE_DEMO_PASSWORD=

RADIUSIQ_API_HEALTH_URL=
MERXUS_API_HEALTH_URL=
SAGESET_API_HEALTH_URL=
SUPPORT_CONSOLE_API_HEALTH_URL=
ROUTE_LOGISTICS_API_HEALTH_URL=
ANYRYDE_API_HEALTH_URL=

SAGESET_PUSH_TEST_TOKEN=
ROUTE_LOGISTICS_PUSH_TEST_TOKEN=
ANYRYDE_PUSH_TEST_TOKEN=

# Optional executive engineering email delivery.
# Draft generation does not require these values. Sending currently supports SendGrid.
WORKSIDEQA_EMAIL_PROVIDER=
WORKSIDEQA_EXECUTIVE_EMAIL_TO=
WORKSIDEQA_EXECUTIVE_EMAIL_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
