{
  "version": 1,
  "products": {
    "merxus": {
      "displayName": "Merxus",
      "manifest": "products/merxus/product.manifest.json",
      "repositories": {
        "windows": {
          "root": "../Merxus",
          "mobile": "../Merxus/mobile",
          "backend": "../Merxus/merxus-ai-backend",
          "web": "../Merxus/web"
        },
        "darwin": {
          "root": "../Merxus",
          "mobile": "../Merxus/mobile",
          "backend": "../Merxus/merxus-ai-backend",
          "web": "../Merxus/web"
        }
      },
      "services": [
        { "name": "firebase", "ports": [9099, 8080, 9199], "role": "Firebase Auth/Firestore/Storage emulators" },
        { "name": "backend", "ports": [8787], "role": "QA backend" },
        { "name": "metro", "ports": [8081], "role": "canonical Maestro Metro" }
      ],
      "device": { "envKey": "MERXUS_ANDROID_EMULATOR_ID", "avdNameEnvKey": "MERXUS_ANDROID_AVD_NAME", "appIdEnvKey": "MERXUS_MAESTRO_ANDROID_APP_ID" },
      "runtime": { "environment": "maestro", "firebaseProjectId": "merxus-maestro-local", "backendUrl": "http://127.0.0.1:8787" },
      "startCommand": ["npm", "run", "qa:start", "--", "--product", "merxus"],
      "doctorCommand": ["npm", "run", "qa:doctor", "--", "--product", "merxus", "--strict"],
      "certificationCommand": "npm run qa:merxus:maestro:phase2:settings:android"
    },
    "sageset": {
      "displayName": "SageSet",
      "manifest": "products/sageset/product.manifest.json",
      "repositories": {
        "windows": {
          "root": "../SageSet",
          "mobile": "../SageSet/mobile",
          "backend": "../SageSet/functions",
          "web": "../SageSet/web"
        },
        "darwin": {
          "root": "../SageSet",
          "mobile": "../SageSet/mobile",
          "backend": "../SageSet/functions",
          "web": "../SageSet/web"
        }
      },
      "services": [
        { "name": "firebase", "ports": [9099, 8080, 9199, 5001], "role": "Firebase Auth/Firestore/Storage/Functions emulators" }
      ],
      "device": { "required": true, "envKey": "SAGESET_ANDROID_EMULATOR_ID", "avdNameEnvKey": "SAGESET_ANDROID_AVD_NAME", "appIdEnvKey": "SAGESET_MAESTRO_ANDROID_APP_ID" },
      "runtime": { "environment": "emulator", "firebaseProjectId": "sageset-maestro-local" },
      "startCommand": ["npm", "run", "qa:start", "--", "--product", "sageset"],
      "doctorCommand": ["npm", "run", "qa:doctor", "--", "--product", "sageset", "--strict"],
      "certificationCommand": "npm run qa:sageset:maestro:phase1"
    }
  }
}
